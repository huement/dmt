{
    "name": "huement/dmt",
    "description": "Huement CLI",
    "keywords": [
        "framework",
        "laravel",
        "laravel zero",
        "console",
        "cli"
    ],
    "homepage": "https://huement.com/dmt",
    "type": "project",
    "license": "MOZ",
    "support": {
        "issues": "https://github.com/huement/dmt/issues",
        "source": "https://github.com/huement/dmt"
    },
    "authors": [
        {
            "name": "Derek Scott",
            "email": "derek@huement.com"
        }
    ],
    "require": {
        "php": "^8.0",
        "alistairshaw/name-the-color": "^0.1.1",
        "claviska/simpleimage": "^4.0",
        "codedungeon/php-messenger": "^1.1",
        "dallgoot/yaml": "^0.9.1",
        "donatj/cli-toolkit": "^0.3.1",
        "greg0/lazer-database": "^2.0",
        "guzzlehttp/guzzle": "^7.5",
        "illuminate/database": "^10.0",
        "illuminate/http": "^10.0",
        "illuminate/log": "^10.0",
        "illuminate/view": "^10.0",
        "imagine/imagine": "^1.3",
        "intervention/image": "^2.7",
        "jc21/clitable": "^1.2",
        "kevinlebrun/colors.php": "^1.0",
        "laminas/laminas-text": "*",
        "laravel-zero/framework": "^10.0.2",
        "lastguest/pixeler": "^1.1",
        "league/climate": "^3.8",
        "mikealmond/color": "^0.1.5",
        "mistic100/randomcolor": "^1.0",
        "nesbot/carbon": "^2.69",
        "nunomaduro/laravel-console-menu": "^3.4",
        "nunomaduro/phpinsights": "^2.8",
        "nunomaduro/termwind": "^1.15.1",
        "ourcodeworld/name-that-color": "dev-master",
        "owenmelbz/laravel-stubs": "^0.0.7",
        "php-school/cli-menu": "^4.3",
        "symfony/console": "^6.3",
        "talesoft/phim": "^1.0",
        "thermage/thermage": "^0.20.1"
    },
    "require-dev": {
        "barryvdh/laravel-ide-helper": "^2.13",
        "fakerphp/faker": "^1.9.1",
        "laravel/pint": "^1.8",
        "mockery/mockery": "^1.5.1",
        "pestphp/pest": "^2.5",
        "psr/container": "^2.0",
        "vimeo/psalm": "^5.15"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "bin": [
        "dmt"
    ]
}
